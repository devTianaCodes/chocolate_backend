{
  "name": "chocolate-backend-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration:db": "RUN_DB_INTEGRATION_TESTS=true vitest run src/__tests__/integration/db.integration.test.js",
    "test:coverage:overall": "node ./scripts/check-overall-coverage.mjs",
    "test:coverage:changed": "node ./scripts/check-new-coverage.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.16.2",
    "nodemailer": "^8.0.1",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
